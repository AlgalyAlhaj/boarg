<script>
    (function() {
        function ready(fn) {
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', fn);
            } else {
                fn();
            }
        }

        const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];

        function formatDate(d) {
            const day = String(d.getDate()).padStart(2, '0');
            return day + '-' + MONTHS[d.getMonth()] + '-' + d.getFullYear();
        }

        function formatTime(d) {
            let h = d.getHours();
            const m = String(d.getMinutes()).padStart(2, '0');
            const ampm = h >= 12 ? 'p.m.' : 'a.m.';
            h = h % 12;
            if (h === 0) h = 12;
            return String(h).padStart(2, '0') + ':' + m + ' ' + ampm;
        }

        // Converts an ISO date (yyyy-mm-dd) into the short "*DD-Mon" style
        // used throughout this report (asterisk = estimated arrival).
        function formatArrival(isoValue) {
            if (!isoValue) return '';
            const parts = isoValue.split('-');
            const y = parseInt(parts[0], 10), mo = parseInt(parts[1], 10) - 1, d = parseInt(parts[2], 10);
            const dt = new Date(y, mo, d);
            return '*' + String(dt.getDate()).padStart(2, '0') + '-' + MONTHS[dt.getMonth()];
        }

        function syncArrivalPrintText(input) {
            const span = input.nextElementSibling;
            if (span && span.classList.contains('arrival-print-text')) {
                span.textContent = formatArrival(input.value);
            }
        }

        function attachRowHandlers(row) {
            row.querySelectorAll('.status-cell').forEach(function(cell) {
                cell.addEventListener('click', function() {
                    if (cell.classList.contains('cell-green')) {
                        cell.classList.remove('cell-green');
                        cell.classList.add('cell-red');
                    } else {
                        cell.classList.remove('cell-red');
                        cell.classList.add('cell-green');
                    }
                });
            });
            const arrivalInput = row.querySelector('.arrival-input');
            if (arrivalInput) {
                syncArrivalPrintText(arrivalInput);
                arrivalInput.addEventListener('change', function() {
                    syncArrivalPrintText(arrivalInput);
                });
            }
            const delBtn = row.querySelector('.del-row');
            if (delBtn) {
                delBtn.addEventListener('click', function() {
                    if (confirm('Delete this row?')) {
                        row.remove();
                    }
                });
            }
        }

        // Builds one <tr> for the table. `data` (optional) pre-fills BILL/QTY/CNTR/Agent
        // (e.g. from a scanned document); Invoice REF and Arrival are always left for
        // the user to fill in by hand.
        function createRowElement(data) {
            data = data || {};
            const row = document.createElement('tr');

            function makeEditableCell(text) {
                const td = document.createElement('td');
                td.className = 'editable-cell';
                td.contentEditable = 'true';
                td.textContent = text || '';
                return td;
            }

            row.appendChild(makeEditableCell(data.bill || 'New Bill'));
            row.appendChild(makeEditableCell(data.qty || '0'));
            row.appendChild(makeEditableCell(data.cntr || '1'));
            row.appendChild(makeEditableCell(data.agent || 'CMA'));
            row.appendChild(makeEditableCell(data.invoiceRef || ''));

            const arrivalTd = document.createElement('td');
            arrivalTd.className = 'arrival-cell';
            const arrivalInput = document.createElement('input');
            arrivalInput.type = 'date';
            arrivalInput.className = 'arrival-input';
            arrivalTd.appendChild(arrivalInput);
            const arrivalSpan = document.createElement('span');
            arrivalSpan.className = 'arrival-print-text';
            arrivalTd.appendChild(arrivalSpan);
            row.appendChild(arrivalTd);

            ['cell-red status-cell', 'cell-red status-cell', 'cell-red status-cell'].forEach(function(cls) {
                const td = document.createElement('td');
                td.className = cls;
                row.appendChild(td);
            });

            const delTd = document.createElement('td');
            delTd.className = 'no-print';
            const delBtn = document.createElement('button');
            delBtn.className = 'action-btn danger-mini del-row';
            delBtn.textContent = '✕';
            delTd.appendChild(delBtn);
            row.appendChild(delTd);

            return row;
        }

        // ---------- Bill of Lading OCR scanning ----------

        function parseBillOfLading(rawText) {
            const upper = rawText.toUpperCase();
            const lines = upper.split(/\r?\n/).map(function(l) { return l.trim(); }).filter(Boolean);

            // BILL number: look near the "BILL OF LADING NUMBER" label first.
            let bill = '';
            const blLabelIdx = lines.findIndex(function(l) { return l.includes('BILL OF LADING NUMBER'); });
            if (blLabelIdx !== -1) {
                for (let i = blLabelIdx; i < Math.min(blLabelIdx + 4, lines.length); i++) {
                    const m = lines[i].match(/\b[A-Z]{2,4}\d{6,9}[A-Z]?\b/);
                    if (m) { bill = m[0]; break; }
                }
            }
            if (!bill) {
                const m = upper.match(/\b[A-Z]{2,4}\d{6,9}[A-Z]?\b/);
                if (m) bill = m[0];
            }

            // CNTR & QTY: the "N X 40HC" / "N PIECE(S)" / "SAY ..." summary block.
            let cntr = '', qty = '';
            const sayIdx = lines.findIndex(function(l) { return l.indexOf('SAY ') === 0 || l.indexOf('SAY') === 0; });
            if (sayIdx > 1) {
                const qtyMatch = lines[sayIdx - 1].match(/(\d[\d,]*)\s*PIECE/);
                if (qtyMatch) qty = qtyMatch[1].replace(/,/g, '');
                const cntrMatch = lines[sayIdx - 2].match(/^(\d+)\s*X\s*\d{2}\s*(?:HC|HQ|GP|FT|RF)?/);
                if (cntrMatch) cntr = cntrMatch[1];
            }
            if (!qty) {
                const pieceNums = Array.from(upper.matchAll(/(\d[\d,]*)\s*PIECE/g)).map(function(m) {
                    return parseInt(m[1].replace(/,/g, ''), 10);
                });
                if (pieceNums.length) qty = String(Math.max.apply(null, pieceNums));
            }
            if (!cntr) {
                const containerCodes = upper.match(/\b[A-Z]{4}\d{6,7}\b/g) || [];
                if (containerCodes.length) cntr = String(containerCodes.length);
            }

            // Agent / carrier — extend this list as you scan other shipping lines.
            let agent = '';
            const CARRIER_MAP = [
                { keyword: 'CMA CGM', code: 'CMA' },
                { keyword: 'PACIFIC INTERNATIONAL LINES', code: 'PIL' },
                { keyword: ' PIL ', code: 'PIL' }
            ];
            for (let i = 0; i < CARRIER_MAP.length; i++) {
                if (upper.indexOf(CARRIER_MAP[i].keyword) !== -1) { agent = CARRIER_MAP[i].code; break; }
            }

            return { bill: bill, qty: qty, cntr: cntr, agent: agent };
        }

        async function renderPdfFirstPageToCanvas(file) {
            const arrayBuffer = await file.arrayBuffer();
            const pdf = await pdfjsLib.getDocument({ data: arrayBuffer }).promise;
            const page = await pdf.getPage(1);
            const viewport = page.getViewport({ scale: 2.5 });
            const canvas = document.createElement('canvas');
            canvas.width = viewport.width;
            canvas.height = viewport.height;
            const ctx = canvas.getContext('2d');
            await page.render({ canvasContext: ctx, viewport: viewport }).promise;
            return canvas;
        }

        async function extractText(file, onProgress) {
            let source = file;
            if (file.type === 'application/pdf' || /\.pdf$/i.test(file.name)) {
                onProgress('Rendering PDF page…');
                source = await renderPdfFirstPageToCanvas(file);
            }
            const result = await Tesseract.recognize(source, 'eng', {
                logger: function(m) {
                    if (m.status && typeof m.progress === 'number') {
                        onProgress('Reading document… ' + m.status + ' (' + Math.round(m.progress * 100) + '%)');
                    }
                }
            });
            return result.data.text;
        }

        ready(function() {
            const printBtn = document.getElementById('printBtn');
            const pdfBtn = document.getElementById('pdfBtn');
            const nowBtn = document.getElementById('nowBtn');
            const addRowBtn = document.getElementById('addRowBtn');
            const exportBtn = document.getElementById('exportBtn');
            const tableBody = document.getElementById('tableBody');

            document.querySelectorAll('#tableBody tr').forEach(attachRowHandlers);

            if (printBtn) {
                printBtn.addEventListener('click', function() {
                    window.print();
                });
            }

            if (nowBtn) {
                nowBtn.addEventListener('click', function() {
                    const now = new Date();
                    document.getElementById('reportDate').textContent = formatDate(now);
                    document.getElementById('lastUpdate').textContent = formatTime(now);
                });
            }

            if (addRowBtn) {
                addRowBtn.addEventListener('click', function() {
                    const row = createRowElement();
                    tableBody.appendChild(row);
                    attachRowHandlers(row);
                    row.querySelector('.editable-cell').focus();
                });
            }

            if (exportBtn) {
                exportBtn.addEventListener('click', function() {
                    // Clone the whole document, strip the editing affordances,
                    // and bake current values into plain attributes so the
                    // exported file is a clean static page (same as manual edits).
                    const clone = document.documentElement.cloneNode(true);

                    clone.querySelectorAll('[contenteditable]').forEach(function(el) {
                        el.removeAttribute('contenteditable');
                    });
                    clone.querySelectorAll('.status-cell').forEach(function(el) {
                        el.classList.remove('status-cell');
                    });
                    // Bake each Arrival date-picker into plain "*DD-Mon" text.
                    const liveArrivalCells = document.querySelectorAll('.arrival-cell');
                    clone.querySelectorAll('.arrival-cell').forEach(function(cell, i) {
                        const liveInput = liveArrivalCells[i].querySelector('.arrival-input');
                        cell.textContent = formatArrival(liveInput ? liveInput.value : '');
                        cell.classList.remove('arrival-cell');
                    });
                    clone.querySelectorAll('.no-print').forEach(function(el) {
                        el.remove();
                    });
                    const hint = clone.querySelector('.hint');
                    if (hint) hint.remove();
                    const scanOverlayClone = clone.querySelector('.scan-overlay');
                    if (scanOverlayClone) scanOverlayClone.remove();

                    const doctype = '<!DOCTYPE html>\n';
                    const html = doctype + clone.outerHTML;

                    const blob = new Blob([html], { type: 'text/html' });
                    const url = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = url;
                    a.download = 'BOARG_Report.html';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                    URL.revokeObjectURL(url);
                });
            }

            if (pdfBtn) {
                pdfBtn.addEventListener('click', function() {
                    const originalText = pdfBtn.textContent;
                    pdfBtn.textContent = '⏳ Generating PDF...';
                    pdfBtn.disabled = true;

                    // Make sure the hidden "print text" for each Arrival cell
                    // is up to date before we hand the DOM to html2canvas.
                    document.querySelectorAll('.arrival-input').forEach(syncArrivalPrintText);

                    setTimeout(function() {
                        try {
                            if (typeof html2pdf === 'undefined') {
                                alert('PDF library not loaded. Use Print → "Save as PDF" instead.');
                                window.print();
                                pdfBtn.textContent = originalText;
                                pdfBtn.disabled = false;
                                return;
                            }

                            const element = document.getElementById('pdfContent');
                            const opt = {
                                margin: [0.4, 0.4, 0.4, 0.4],
                                filename: 'BOARG_Report.pdf',
                                image: { type: 'jpeg', quality: 0.95 },
                                html2canvas: {
                                    scale: 2.5,
                                    letterRendering: true,
                                    backgroundColor: '#ffffff',
                                    logging: false,
                                    // html2canvas renders the live DOM and does NOT apply
                                    // @media print rules, so strip the tip text, delete
                                    // buttons, and date-picker inputs (replaced by their
                                    // plain-text equivalents) on the cloned copy it uses.
                                    onclone: function(clonedDoc) {
                                        const hintEl = clonedDoc.querySelector('.hint');
                                        if (hintEl) hintEl.remove();
                                        clonedDoc.querySelectorAll('.no-print').forEach(function(el) {
                                            el.remove();
                                        });
                                        clonedDoc.querySelectorAll('.arrival-input').forEach(function(el) {
                                            el.style.display = 'none';
                                        });
                                        clonedDoc.querySelectorAll('.arrival-print-text').forEach(function(el) {
                                            el.style.display = 'inline';
                                        });
                                    }
                                },
                                jsPDF: { unit: 'in', format: 'letter', orientation: 'landscape' }
                            };

                            html2pdf().set(opt).from(element).save().then(function() {
                                pdfBtn.textContent = originalText;
                                pdfBtn.disabled = false;
                            }).catch(function(err) {
                                console.error('PDF error:', err);
                                alert('PDF failed. Try Print button → "Save as PDF".');
                                pdfBtn.textContent = originalText;
                                pdfBtn.disabled = false;
                            });
                        } catch(err) {
                            console.error('PDF exception:', err);
                            alert('Error generating PDF. Use Print button.');
                            pdfBtn.textContent = originalText;
                            pdfBtn.disabled = false;
                        }
                    }, 50);
                });
            }

            // ---------- Scan Bill of Lading wiring ----------
            const scanBtn = document.getElementById('scanBtn');
            const blFileInput = document.getElementById('blFileInput');
            const scanOverlay = document.getElementById('scanOverlay');
            const scanLoading = document.getElementById('scanLoading');
            const scanReview = document.getElementById('scanReview');
            const scanErrorBox = document.getElementById('scanErrorBox');
            const scanProgressText = document.getElementById('scanProgressText');
            const scanCancelBtn = document.getElementById('scanCancelBtn');
            const scanAddBtn = document.getElementById('scanAddBtn');
            const scanErrorCloseBtn = document.getElementById('scanErrorCloseBtn');

            function openOverlayLoading() {
                scanOverlay.classList.add('active');
                scanLoading.style.display = 'block';
                scanReview.style.display = 'none';
                scanErrorBox.style.display = 'none';
                scanProgressText.textContent = 'Starting…';
            }
            function closeOverlay() {
                scanOverlay.classList.remove('active');
            }
            function showReviewForm(parsed, rawText) {
                scanLoading.style.display = 'none';
                scanReview.style.display = 'block';
                document.getElementById('scanBill').value = parsed.bill;
                document.getElementById('scanQty').value = parsed.qty;
                document.getElementById('scanCntr').value = parsed.cntr;
                document.getElementById('scanAgent').value = parsed.agent;
                document.getElementById('scanRawText').value = rawText;
            }
            function showScanError(msg) {
                scanLoading.style.display = 'none';
                scanErrorBox.style.display = 'block';
                document.getElementById('scanErrorMsg').textContent = msg;
            }

            if (scanBtn && blFileInput) {
                scanBtn.addEventListener('click', function() {
                    blFileInput.click();
                });
                blFileInput.addEventListener('change', async function(e) {
                    const file = e.target.files[0];
                    if (!file) return;
                    openOverlayLoading();
                    try {
                        const text = await extractText(file, function(msg) {
                            scanProgressText.textContent = msg;
                        });
                        const parsed = parseBillOfLading(text);
                        showReviewForm(parsed, text);
                    } catch (err) {
                        console.error('OCR error:', err);
                        const reason = (err && err.message) ? err.message : String(err);
                        const isLocalFile = window.location.protocol === 'file:';
                        const hint = isLocalFile
                            ? 'This page is open as a local file — Scan needs to be opened from a real web address (e.g. your GitHub Pages link) to load the OCR engine.'
                            : 'Try a clearer, well-lit photo (or a PDF), or enter the row manually.';
                        showScanError(hint + '\n\nDetails: ' + reason);
                    }
                    blFileInput.value = '';
                });
            }
            if (scanCancelBtn) scanCancelBtn.addEventListener('click', closeOverlay);
            if (scanErrorCloseBtn) scanErrorCloseBtn.addEventListener('click', closeOverlay);
            if (scanAddBtn) {
                scanAddBtn.addEventListener('click', function() {
                    const data = {
                        bill: document.getElementById('scanBill').value.trim(),
                        qty: document.getElementById('scanQty').value.trim(),
                        cntr: document.getElementById('scanCntr').value.trim(),
                        agent: document.getElementById('scanAgent').value.trim()
                    };
                    const row = createRowElement(data);
                    tableBody.appendChild(row);
                    attachRowHandlers(row);
                    closeOverlay();
                    row.scrollIntoView({ behavior: 'smooth', block: 'center' });
                });
            }
        });
    })();
</script>
</body>
</html>